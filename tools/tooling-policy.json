{
  "schemaVersion": 1,
  "policy": "container-only-development-tooling",
  "hostBootstrapAllowlist": [
    "git",
    "docker-compatible-runtime",
    "nektos-act-or-portable-launcher",
    "powershell-or-posix-shell"
  ],
  "containerRequiredCategories": [
    "package-managers",
    "compilers-and-transpilers",
    "bundlers",
    "linters",
    "formatters",
    "unit-test-runners",
    "integration-test-runners",
    "formal-model-checkers",
    "static-analysis",
    "security-scanners",
    "license-scanners",
    "sbom-generators",
    "documentation-generators",
    "browser-automation",
    "browser-binaries",
    "packaging",
    "signing",
    "release-evidence",
    "publication-clients"
  ],
  "interfaces": {
    "human": "PowerShell and POSIX launchers with readable diagnostics",
    "automation": "stable commands, exit codes, and JSON result files",
    "agent": "idempotent operations, runtime descriptor, bounded outputs, and no prompts"
  },
  "browserTesting": {
    "default": "headless-disposable-container",
    "profiles": "ephemeral",
    "headedException": "explicit manual diagnostics only",
    "hostNativeQualificationException": {
      "annotation": "host-bound-browser-qualification",
      "purpose": "Qualify OS-native browser behavior that a Linux container cannot prove.",
      "allowedWorkflow": ".github/workflows/workbench-browser-smoke.yml",
      "runner": "ephemeral-github-hosted-only",
      "requirements": [
        "project-build-and-test-tooling-remains-containerized",
        "browser-automation-version-is-pinned",
        "browser-automation-and-browser-cache-live-under-runner-temp",
        "browser-profile-is-ephemeral",
        "no-production-credentials-signing-or-publication-authority",
        "machine-evidence-explicitly-bounds-claims"
      ]
    }
  },
  "forbiddenHostArtifacts": [
    "persistent-node_modules",
    "persistent-pnpm-store",
    "python-virtual-environment",
    "persistent-downloaded-browser-binaries",
    "global-project-packages"
  ],
  "ephemeralHostQualificationArtifacts": [
    "runner-temp/playwright-node_modules",
    "runner-temp/playwright-browser-cache",
    "ephemeral-browser-profile"
  ]
}
